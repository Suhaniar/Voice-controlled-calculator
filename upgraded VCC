def speak_local(text):
    """Use pyttsx3 to speak (English/local offline). Called in thread to avoid blocking."""
    try:
        py_engine.say(str(text))
        py_engine.runAndWait()
    except RuntimeError:
        pass

def speak_gtts(text, lang="hi"):
    """Use gTTS to generate audio and return raw bytes for Streamlit audio player."""
    try:
        tts = gTTS(text=str(text), lang=lang)
        buf = io.BytesIO()
        tts.write_to_fp(buf)
        buf.seek(0)
        return buf.read()
    except Exception as e:
        return None

def speak(text):
    """
    Unified speak function:
     - If text detected as Hindi (Devanagari or language detection), use gTTS and play.
     - Else use pyttsx3.
    We run pyttsx3 in a separate thread to avoid Streamlit blocking.
    """
    # naive detection for Devanagari script
    if re.search(r'[\u0900-\u097F]', text):
        audio_bytes = speak_gtts(text, lang="hi")
        if audio_bytes:
            # stream audio in streamlit — but here we prefer asynchronous pyttsx3 fallback
            # return audio bytes to be played in UI if desired
            return audio_bytes
    # default: pyttsx3 speak asynchronously
    threading.Thread(target=speak_local, args=(text,), daemon=True).start()
    return None

