def plot_emi_schedule(schedule):
    """
    schedule: list of tuples (month, emi, principal_paid, interest, balance)
    """
    if not schedule:
        st.info("No EMI schedule available.")
        return
    df = pd.DataFrame(schedule, columns=["Month","EMI","Principal","Interest","Balance"])
    fig, ax = plt.subplots(figsize=(8,4))
    ax.plot(df["Month"], df["Balance"], marker='o')
    ax.set_title("Outstanding Balance over Months")
    ax.set_xlabel("Month")
    ax.set_ylabel("Balance")
    ax.grid(True)
    st.pyplot(fig)
    st.dataframe(df.head(12))  # show first year rows

